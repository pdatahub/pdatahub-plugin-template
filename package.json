{
  "name": "pdatahub-plugin-template",
  "version": "0.1.0",
  "description": "Template for pdatahub plugins — copy this repo to start your own",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
