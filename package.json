  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@pdatahub/plugin-sdk": "https://github.com/pdatahub/pdatahub/releases/download/v0.2.4/pdatahub-plugin-sdk-0.2.4.tgz",
    "undici": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
